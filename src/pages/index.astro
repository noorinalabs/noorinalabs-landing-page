---
import PageLayout from "../layouts/PageLayout.astro";
import SEO from "../components/SEO.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { Picture } from "astro:assets";
/*
 * Direction-C hero (#144) — a single full-bleed architectural photograph.
 *
 * Asset provenance (recorded internally — there is NO on-page attribution
 * credit, per the owner decision on lp#139/lp#140; the imagery is CC0/public
 * domain so none is required):
 *   Subject : Dome interior, Jameh (Friday) Mosque of Yazd, Iran
 *   Source  : Wikimedia Commons —
 *             https://commons.wikimedia.org/wiki/File:Dome_of_Jamh_Mosque,_Yazd,_Iran.jpg
 *   Author  : Erik Albers (Commons User:Dreirik), own work
 *   License : CC0 1.0 — Creative Commons Zero, Public Domain Dedication
 *
 * The file was downloaded ONCE, downscaled to a 1920px-wide source, and
 * committed under src/assets/ — it is NEVER hot-linked from the Wikimedia CDN
 * at runtime. `astro:assets` (the <Picture> below) re-encodes it to responsive
 * AVIF/WebP (with a JPEG fallback) at build time. See docs/CREDITS.md.
 */
import heroImage from "../assets/hero-yazd-dome.jpg";
---

<PageLayout
  title="Home"
  description="Noorina Labs builds open tools for Islamic scholarly research — starting with the Isnad Graph, a computational hadith analysis platform."
>
  <SEO slot="head" />

  <!-- Hero — full-bleed architectural photograph (Direction C, #144) -->
  <section class="hero" aria-labelledby="hero-heading">
    <Picture
      src={heroImage}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      quality={50}
      alt="Tiled interior dome of the Jameh Mosque of Yazd, Iran"
      class="hero-image"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      pictureAttributes={{
        class: "hero-media",
        "data-parallax": "",
        "data-parallax-speed": "0.18",
      }}
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-content reveal" data-reveal>
      <h1 id="hero-heading" class="hero-title">
        Illuminating Fourteen Centuries<br />of Islamic Scholarship
      </h1>
      <p class="hero-subtitle">
        The Islamic scholarly tradition represents over fourteen centuries of
        accumulated human knowledge. Noorina Labs builds open computational
        tools to make this tradition navigable, searchable, and accessible to
        all.
      </p>
      <div class="hero-pillars">
        <span class="pillar">Open research</span>
        <span class="pillar">Global reach</span>
        <span class="pillar">Source-neutral</span>
        <span class="pillar">Community-built</span>
      </div>
      <div class="hero-actions">
        <a href="/projects/isnad-graph" class="btn-primary">
          Explore the Isnad Graph
        </a>
        <a href="/team" class="btn-secondary"> Meet the Team </a>
      </div>
    </div>
  </section>

  <!-- Guiding Principle -->
  <section class="section" aria-labelledby="principle-heading">
    <div class="section-container principle-container">
      <h2 id="principle-heading" class="sr-only">Guiding Principle</h2>
      <blockquote class="principle-quote reveal" data-reveal>
        <p>
          Noorina Labs will never privilege one school of thought, one
          collection, or one interpretive tradition over another. Our platform
          illuminates — it does not arbitrate.
        </p>
      </blockquote>
    </div>
  </section>

  <!-- The Problem -->
  <section class="section section-alt" aria-labelledby="problem-heading">
    <div class="section-container">
      <h2 id="problem-heading" class="section-title reveal" data-reveal>
        The Problem
      </h2>
      <p class="section-intro reveal reveal-delay-1" data-reveal>
        Despite fourteen centuries of meticulous scholarship and 1.9 billion
        Muslims worldwide, there are zero cross-tradition graph tools for
        studying hadith transmission. Existing digital resources remain siloed
        by collection, school, and language. Five fundamental questions remain
        unanswerable without modern computational tools:
      </p>
      <ol class="problem-questions" role="list">
        <li>
          Can a researcher look up a narrator across Sunni and Shia collections
          in a single search?
        </li>
        <li>
          Can we identify parallel transmissions of the same hadith through
          independent chains?
        </li>
        <li>
          Can we visualize the network structure of narration — who transmitted
          to whom, and through how many paths?
        </li>
        <li>
          Can we map the overlap between Sunni and Shia narrator networks to
          find common scholarly ground?
        </li>
        <li>
          Can we trace attribution patterns back to individual Companions to
          understand the roots of the tradition?
        </li>
      </ol>
      <div class="problem-stats">
        <div class="stat reveal" data-reveal>
          <span class="stat-number">1.9B</span>
          <span class="stat-label">Muslims worldwide</span>
        </div>
        <div class="stat reveal reveal-delay-1" data-reveal>
          <span class="stat-number">14+</span>
          <span class="stat-label">centuries of scholarship</span>
        </div>
        <div class="stat reveal reveal-delay-2" data-reveal>
          <span class="stat-number">0</span>
          <span class="stat-label">cross-tradition graph tools</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Isnad Graph Capabilities -->
  <section id="projects" class="section" aria-labelledby="capabilities-heading">
    <div class="section-container">
      <h2 id="capabilities-heading" class="section-title reveal" data-reveal>
        The Isnad Graph
      </h2>
      <p class="section-intro reveal reveal-delay-1" data-reveal>
        A computational hadith analysis platform that maps chains of narration (<span
          lang="ar">أسانيد</span
        >) as an interactive, searchable graph. Our first product answers the
        questions that existing tools cannot.
      </p>
      <div class="capabilities-grid">
        <div class="card card-surface reveal" data-reveal>
          <h3>Cross-Collection Search</h3>
          <p>
            Search narrators and hadith across major Sunni and Shia collections
            simultaneously — no more switching between siloed databases.
          </p>
        </div>
        <div class="card card-surface reveal reveal-delay-1" data-reveal>
          <h3>Graph Explorer</h3>
          <p>
            Visualize narrator networks as an interactive graph. Zoom, filter,
            and trace transmission paths between any two narrators.
          </p>
        </div>
        <div class="card card-surface reveal reveal-delay-2" data-reveal>
          <h3>Cross-Tradition Comparison</h3>
          <p>
            Compare narrator assessments across Sunni and Shia traditions
            side-by-side. Discover shared narrators and divergent evaluations.
          </p>
        </div>
        <div class="card card-surface reveal" data-reveal>
          <h3>Historical Context</h3>
          <p>
            Biographical profiles with teacher-student relationships,
            reliability assessments, and geographical data drawn from classical
            rijal literature.
          </p>
        </div>
        <div class="card card-surface reveal reveal-delay-1" data-reveal>
          <h3>Collection-Level Analysis</h3>
          <p>
            Understand the structure of individual hadith collections — most
            frequent narrators, chain patterns, and transmission networks.
          </p>
        </div>
      </div>
      <ScrollReveal class="section-cta" delay={1}>
        <a href="/projects/isnad-graph" class="btn-primary">
          Explore the Isnad Graph
        </a>
      </ScrollReveal>
    </div>
  </section>

  <!-- Why Now -->
  <section class="section section-alt" aria-labelledby="why-now-heading">
    <div class="section-container">
      <h2 id="why-now-heading" class="section-title reveal" data-reveal>
        Why Now
      </h2>
      <div class="why-now-grid">
        <div class="card card-center reveal" data-reveal>
          <h3>Computational tools have matured</h3>
          <p>
            Graph databases, network analysis, and natural language processing
            have reached the point where they can meaningfully support — not
            replace — hadith scholarship.
          </p>
        </div>
        <div class="card card-center reveal reveal-delay-1" data-reveal>
          <h3>Open data is available</h3>
          <p>
            Digitized hadith collections and biographical dictionaries are now
            accessible in structured formats, making computational analysis
            possible for the first time.
          </p>
        </div>
        <div class="card card-center reveal reveal-delay-2" data-reveal>
          <h3>Institutional appetite is growing</h3>
          <p>
            Universities, research centers, and Islamic institutions are
            actively seeking digital tools to support hadith studies and make
            scholarship more accessible globally.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partnership & Support -->
  <section class="section" aria-labelledby="partnership-heading">
    <div class="section-container">
      <h2 id="partnership-heading" class="section-title reveal" data-reveal>
        Partnership & Support
      </h2>
      <p class="section-intro reveal reveal-delay-1" data-reveal>
        Noorina Labs is building infrastructure for the next generation of
        Islamic scholarly research. We work with institutions, researchers, and
        funders who share our commitment to open, rigorous, and inclusive tools.
      </p>
      <div class="partnership-grid">
        <div class="card card-surface reveal" data-reveal>
          <h3>Research Partnership</h3>
          <p>
            Collaborate on data curation, scholarly review, and new analytical
            features. We work closely with domain experts to ensure every tool
            meets the standards of the tradition.
          </p>
        </div>
        <div class="card card-surface reveal reveal-delay-1" data-reveal>
          <h3>Institutional License</h3>
          <p>
            Integrate the Isnad Graph into your university or research center.
            Custom deployments, dedicated support, and curriculum integration
            available for academic institutions.
          </p>
        </div>
        <div class="card card-surface reveal reveal-delay-2" data-reveal>
          <h3>Grant & Philanthropic</h3>
          <p>
            Support open-source infrastructure for Islamic scholarship. Grants
            and donations fund data ingestion, new features, and free access for
            students and independent researchers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section section-alt" aria-labelledby="contact-heading">
    <div class="section-container contact-container">
      <h2 id="contact-heading" class="section-title reveal" data-reveal>
        Get in Touch
      </h2>
      <p class="section-intro reveal reveal-delay-1" data-reveal>
        Whether you are a researcher, institution, funder, or curious learner,
        we would love to hear from you.
      </p>
      <ScrollReveal as="div" delay={2}>
        <a href="mailto:info@noorinalabs.com" class="btn-primary">
          info@noorinalabs.com
        </a>
      </ScrollReveal>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero — full-bleed architectural photograph (#144, Direction C) */
  .hero {
    /*
     * The hero is a CONSTANT dark photographic surface in BOTH themes, so its
     * text + scrim must NOT consume the theme-flipping --color-foreground /
     * --color-background (those would invert to dark ink text over the dark
     * photo in light theme and fail contrast). Instead we treat the hero as a
     * permanently-dark "island" — the standard pattern for a full-bleed photo
     * hero — and pin to the DS's theme-STABLE brand ink plus the DS dark-theme
     * parchment foreground value:
     *   --hero-ink       = --color-brand-navy-dark (declared only at :root, so
     *                      identical in light + dark) — the scrim base.
     *   --hero-parchment = the DS dark-theme --color-foreground value
     *                      (oklch .92 .01 85), i.e. parchment-on-ink. Used for
     *                      headline/subtitle so contrast holds over the photo
     *                      regardless of the active theme.
     * This is a deliberate, scoped exception to the #118 "consume DS semantic
     * tokens" rule for the on-media legibility layer, not a reintroduced color
     * ladder.
     */
    --hero-ink: var(--color-brand-navy-dark);
    --hero-parchment: oklch(0.92 0.01 85);

    position: relative;
    min-height: 86vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7rem 1.5rem 5rem;
    color: var(--hero-parchment);
    overflow: hidden;
    /* New stacking context so the negative-z image/scrim layers stay behind
       the hero content without escaping behind the page background. */
    isolation: isolate;
  }

  /*
   * Full-bleed image layer. `astro:assets` <Picture> renders
   * <picture class="hero-media"><source …><img class="hero-image"></picture>.
   * The <picture> is the positioned, parallaxed layer; the <img> fills it via
   * object-fit: cover. Extra bleed below the hero (inset bottom -30%) means the
   * parallax drift (the layer translates up to ~18% of scroll via
   * [data-parallax]) never exposes a gap at the bottom edge — the hero clips
   * the overflow. With motion disabled the extra height is simply clipped.
   */
  .hero-media {
    position: absolute;
    inset: 0 0 -30% 0;
    z-index: -2;
    display: block;
    pointer-events: none;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    display: block;
  }

  /*
   * Legibility scrim over the photograph. A vertical gradient darkens the top
   * (under the nav) and bottom, and a centred radial vignette lifts the
   * headline off the busy tilework. Built from the theme-stable --hero-ink so
   * the contrast budget is identical in light and dark themes; a faint sienna
   * (--color-primary) wash ties it to the brand without tinting the text.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        115% 78% at 50% 44%,
        transparent 0%,
        color-mix(in oklch, var(--hero-ink) 42%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklch, var(--hero-ink) 78%, transparent) 0%,
        color-mix(in oklch, var(--hero-ink) 46%, transparent) 38%,
        color-mix(in oklch, var(--hero-ink) 60%, transparent) 76%,
        color-mix(in oklch, var(--hero-ink) 82%, transparent) 100%
      ),
      linear-gradient(
        135deg,
        color-mix(in oklch, var(--color-primary) 18%, transparent) 0%,
        transparent 55%
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 48rem;
    text-align: center;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: var(--hero-parchment);
    /* Soft drop shadow keeps the headline crisp over the brightest pendentive
       highlights in the photo. */
    text-shadow: 0 1px 24px
      color-mix(in oklch, var(--hero-ink) 70%, transparent);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    /* Slightly dimmed parchment (theme-stable) — see .hero rationale. */
    color: color-mix(in oklch, var(--hero-parchment) 88%, transparent);
    max-width: 38rem;
    margin: 0 auto 2rem;
    text-shadow: 0 1px 16px
      color-mix(in oklch, var(--hero-ink) 60%, transparent);
  }

  .hero-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .pillar {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    /* Warm gold accent (theme-stable DS brand token) reads as a highlight over
       the dark photo and echoes the dome's gilded tilework. */
    color: var(--color-brand-gold-light);
    letter-spacing: 0.02em;
    text-shadow: 0 1px 12px
      color-mix(in oklch, var(--hero-ink) 65%, transparent);
  }

  .hero-pillars .pillar:not(:last-child)::after {
    content: "\00b7";
    margin-left: 0.75rem;
    color: color-mix(in oklch, var(--hero-parchment) 50%, transparent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  /*
   * Hero-scoped button overrides. The global .btn-secondary uses
   * --color-foreground / --color-border, which over the dark hero scrim would
   * render dark-on-dark in light theme. Re-point it to the theme-stable
   * parchment so it stays legible on the photo in both themes. The primary
   * (sienna) button already contrasts on the dark scrim and is left as-is.
   */
  .hero .btn-secondary {
    color: var(--hero-parchment);
    border-color: color-mix(in oklch, var(--hero-parchment) 55%, transparent);
  }

  .hero .btn-secondary:hover {
    color: var(--hero-parchment);
    border-color: var(--hero-parchment);
    background: color-mix(in oklch, var(--hero-parchment) 12%, transparent);
  }

  /* Buttons, section helpers, and shared card primitives are defined globally
     in src/styles/global.css (extracted in #59). Hero/principle/grid styles
     and one-off page-specific styles remain scoped below. */

  /* Guiding Principle */
  .principle-container {
    max-width: 48rem;
  }

  .principle-quote {
    border-left: 3px solid var(--color-primary);
    padding: 1.5rem 1.5rem 1.5rem 2rem;
    background: var(--color-muted);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .principle-quote p {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--color-foreground);
  }

  /* Problem Section */
  .problem-questions {
    max-width: 48rem;
    margin: 0 auto 2.5rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .problem-questions li {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .problem-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3rem;
    margin-top: 2rem;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
  }

  /* Capabilities Grid */
  .capabilities-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .capabilities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Why Now Grid — distinct breakpoint/gap from capabilities; card visuals
     come from .card.card-center in global.css */
  .why-now-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .why-now-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Partnership Grid — same shape as why-now but card visuals come from
     .card.card-surface in global.css */
  .partnership-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .partnership-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Contact */
  .contact-container {
    text-align: center;
  }
</style>
